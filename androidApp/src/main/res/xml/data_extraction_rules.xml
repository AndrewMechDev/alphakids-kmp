<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31) backup and device-to-device transfer rules.
    android:allowBackup="false" disables cloud backup, but on API 31+ it does not
    stop device-to-device transfer, so every domain is excluded here as well.
    Nothing local is worth restoring: progress lives on the backend and the
    SharedPreferences file holds auth tokens that must never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
