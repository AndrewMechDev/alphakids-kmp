<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower (API 30-) backup rules. android:allowBackup="false" already
    disables backup there; these exclusions keep auth tokens out of any backup if
    allowBackup is ever turned back on. See data_extraction_rules.xml for API 31+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
