# Copy this file to keystore.properties (same folder) and fill in real values.
# keystore.properties is gitignored — never commit real signing credentials.
#
# Generate the keystore first if you don't have one yet (do this ONCE and
# back it up somewhere safe — losing it means you can never publish an
# update to the same Play Store listing again):
#
#   keytool -genkeypair -v -keystore alphakids-release.keystore \
#     -alias alphakids -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is relative to this androidApp/ directory.
storeFile=../alphakids-release.keystore
storePassword=CHANGE_ME
keyAlias=alphakids
keyPassword=CHANGE_ME
